function PARTITIONING_BOOT_DEVICE_label() {
	local devshort=$PARTITIONING_BOOT_DEVICE
	devshort=$(shorten_device "$devshort")
	if [[ -e "$PARTITIONING_BOOT_DEVICE" ]]; then
		echo " ├ ($devshort)"
	else
		echo " ├ (\Z1$devshort\Zn)"
	fi
}
