	if menu_radiolist_labeled \
		"Graphics drivers" \
		"Select the graphics driver set (VIDEO_CARDS)." \
		"$VIDEO_CARDS" \
		"auto"     "Detect automatically (recommended)" \
		"amd"      "AMD (amdgpu, radeonsi)" \
		"intel"    "Intel" \
		"nouveau"  "NVIDIA (open source nouveau)" \
		"virgl"    "Virtual machine (virtio / QEMU)" \
		"qxl"      "Virtual machine (QXL / SPICE, e.g. GNOME Boxes)" \
