# ---- Desktop -----------------------------------------------------------

function desktop_name() {
	case "$DESKTOP" in
		none)   echo "none (console only)" ;;
		plasma) echo "KDE Plasma" ;;
		gnome)  echo "GNOME" ;;
		xfce)   echo "Xfce" ;;
		cosmic) echo "COSMIC (experimental)" ;;
	esac
}

function DESKTOP_tag()   { echo "Desktop environment"; }
function DESKTOP_label() { echo "($(desktop_name))"; }
function DESKTOP_show()  { return 0; }
function DESKTOP_help()  { echo "Installs a graphical desktop with display manager, PipeWire audio, Firefox and Xorg/Wayland support. The matching gentoo desktop profile is selected, and the system is updated for it (@world), exactly like the handbook describes. This takes a long time without the binary package host. Requires the plain 'systemd' or 'openrc' stage3 variant."; }
function DESKTOP_menu()  {
	local prev_desktop="$DESKTOP"
	if [[ $STAGE3_VARIANT != "systemd" && $STAGE3_VARIANT != "openrc" ]]; then
		dialog --msgbox "Desktop environments are only supported with the plain 'systemd' or 'openrc' stage3 variants. Change the stage3 variant first." 8 64
		return 0
	fi
	if menu_radiolist_labeled \
		"Desktop environment" \
		"Select the desktop environment to install." \
		"$DESKTOP" \
		"none"   "None - console only (minimal system)" \
		"plasma" "KDE Plasma (SDDM)" \
		"gnome"  "GNOME (GDM)" \
		"xfce"   "Xfce (LightDM) - lightweight" \
		"cosmic" "COSMIC (cosmic-greeter) - EXPERIMENTAL, community overlay, long build"
	then
		DESKTOP="$dialog_out"
		UNSAVED_CHANGES=true
		# Keep the greeter choice valid for the new desktop.
		if [[ $DESKTOP == "none" || ( $DISPLAY_MANAGER == "cosmic-greeter" && $DESKTOP != "cosmic" ) ]]; then
			DISPLAY_MANAGER="auto"
		fi
		if [[ $DESKTOP != "none" && $NETWORK_BACKEND != "networkmanager" ]]; then
			if dialog --yesno "Desktops are easiest to use with NetworkManager (graphical Wi-Fi/VPN settings). Switch the network setup to NetworkManager?" 8 64; then
				NETWORK_BACKEND="networkmanager"
			fi
		fi
	fi
}

function DISPLAY_MANAGER_tag()   { echo " ├ Login screen (greeter)"; }
function DISPLAY_MANAGER_label() { echo " ├ ($(display_manager_name))"; }
function DISPLAY_MANAGER_show()  { [[ $DESKTOP != "none" ]]; }
function display_manager_name() {
	case "$DISPLAY_MANAGER" in
		auto)
			case "$DESKTOP" in
				plasma) echo "auto: SDDM" ;;
				gnome)  echo "auto: GDM" ;;
				xfce)   echo "auto: LightDM" ;;
				cosmic) echo "auto: cosmic-greeter" ;;
				*)      echo "auto" ;;
			esac ;;
		sddm)           echo "SDDM" ;;
		gdm)            echo "GDM" ;;
		lightdm)        echo "LightDM" ;;
		cosmic-greeter) echo "cosmic-greeter (greetd)" ;;
	esac
}
function DISPLAY_MANAGER_help()  { echo "The graphical login screen. 'auto' picks the usual one for the chosen desktop (SDDM for Plasma, GDM for GNOME, LightDM for Xfce, cosmic-greeter for COSMIC). Any of SDDM, GDM and LightDM can be combined with any desktop; cosmic-greeter only works with COSMIC."; }
function DISPLAY_MANAGER_menu()  {
	local items=(
		"auto"    "Automatic (matches the desktop)"
		"sddm"    "SDDM (KDE's login screen)"
		"gdm"     "GDM (GNOME's login screen)"
		"lightdm" "LightDM (lightweight, GTK greeter)"
	)
	[[ $DESKTOP == "cosmic" ]] && items+=("cosmic-greeter" "cosmic-greeter (via greetd)")
	if menu_radiolist_labeled \
		"Login screen" \
		"Select the graphical login screen (display manager / greeter)." \
		"$DISPLAY_MANAGER" \
		"${items[@]}"
	then
		DISPLAY_MANAGER="$dialog_out"
		UNSAVED_CHANGES=true
	fi
}

