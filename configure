function VIDEO_CARDS_label() { echo " └ ($VIDEO_CARDS)"; }
function VIDEO_CARDS_show()  { [[ $DESKTOP != "none" ]]; }
function VIDEO_CARDS_help()  { echo "Sets VIDEO_CARDS in make.conf. 'auto' detects the GPU(s) of this machine when installing (AMD, Intel, Nouveau for NVIDIA, VMware, virtio). Proprietary NVIDIA drivers are not installed automatically; use nouveau now and switch later."; }
